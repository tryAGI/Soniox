<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);MEAI001;CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>Generated C# SDK for Soniox — speech-to-text, text-to-speech, voice cloning, translation, real-time WebSocket support, and Microsoft.Extensions.AI integration.</Description>
    <PackageTags>soniox;speech-to-text;stt;text-to-speech;tts;voice-cloning;transcription;translation;realtime;websocket;meai;api;sdk;dotnet;openapi;generated</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
  </ItemGroup>

</Project>
